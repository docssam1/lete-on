# /opt/nm-notify-relay/relay.env  — 실제 값은 여기(서버)에만. git·채팅에 올리지 말 것.
RELAY_KEY=여기에_릴레이_암호          # Supabase Vault의 NOTIFY_RELAY_KEY 와 같은 값
ALIGO_API_KEY=알리고_API_키
ALIGO_USER_ID=알리고_아이디
ALIGO_SENDER=01012345678               # 알리고에 등록된 발신번호
PORT=8090
ALIGO_TESTMODE=Y                       # 처음엔 Y로 켜서 응답만 확인, 실제 발송 시 N
MAX_PER_HOUR=200
