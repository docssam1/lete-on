#!/bin/bash
# ============================================================
#  독쌤 목소리 — 스스로 공부 덱 대사(fcs-, 207줄)만 만들기 (맥판)
#  PC(윈도우)가 손글씨 판서(fcb-)를 만드는 동안 맥이 덱 대사를 나눠 만든다 — 같은 줄을 겹쳐 만들지 않는다.
#  쓰는 법: 더블클릭. 다운로드 폴더의 「녹음 2026-09-24 045754.mp4」를 쓰고, 없으면 끌어다 놓으라고 묻는다.
#  나머지(설치·목소리 확인·듣기.html)는 omnivoice-docssam.command 와 같다. 작업 지시서: WORK-ORDER-docssam-voice-mac-20261028.md
# ============================================================
cd "$(dirname "$0")" || exit 1
exec ./omnivoice-docssam.command "${1:-$HOME/Downloads/녹음 2026-09-24 045754.mp4}" --prefix fcs-
